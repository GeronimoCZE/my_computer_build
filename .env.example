# Copy to .env (or set these in your host's environment). Every key is optional:
# without them the site uses the estimates in data/prices.json.

PORT=4030

# Best Buy Products API (live new prices, US). Get a key at https://developer.bestbuy.com
BESTBUY_API_KEY=

# eBay Browse API (live used prices, US). Create a keyset at https://developer.ebay.com/my/keys
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# production or sandbox
EBAY_ENV=production
EBAY_MARKETPLACE=EBAY_US

# How often to refresh live prices, in hours (eBay data must be under 6 h old)
PRICE_TTL_HOURS=6

# Lets you trigger POST /api/prices/refresh with "Authorization: Bearer <token>"
ADMIN_TOKEN=
