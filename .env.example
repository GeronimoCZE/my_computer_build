# Copy to .env (or set these in your host's environment). Every key is optional:
# without them the site runs locally with seeded price estimates and no sign-in.

PORT=4030

# ---------------------------------------------------------------- the public site
# Your public address, no trailing slash. Canonical links, the sitemap, social images
# and the Google sign-in callback all use it. Leave empty for local development.
SITE_URL=

# Footer credit: "Designed and built by <CREATOR_NAME>" linking to CREATOR_URL.
# CREATOR_NAME defaults to the domain of CREATOR_URL.
CREATOR_URL=
CREATOR_NAME=

# Shown on the About, privacy and terms pages as the way to reach you.
CONTACT_EMAIL=
# Who runs the site, for the privacy policy (defaults to CREATOR_NAME) and where.
OPERATOR_NAME=
OPERATOR_COUNTRY=the Czech Republic

# ---------------------------------------------------------------- sign in with Google
# Google Cloud console > APIs & Services > Credentials > OAuth client ID (Web application).
# Authorised redirect URI: <SITE_URL>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Signs the session cookie. Any long random string, e.g. from: openssl rand -hex 32
# Without it, everyone is signed out whenever the server restarts.
SESSION_SECRET=

# ---------------------------------------------------------------- security
# Other sites allowed to call the API with cookies, comma-separated full origins.
# Your own SITE_URL is always allowed. Usually leave empty.
CORS_ORIGINS=
# Proxies in front of the server, so rate limits see real visitor IPs:
# loopback (nginx or Caddy on the same machine, the default), or a number of hops,
# e.g. 2 for Cloudflare in front of nginx.
TRUST_PROXY=loopback
# Requests per minute per visitor (IP, or account when signed in).
RATE_LIMIT_FLOOD=1200
RATE_LIMIT_PAGES=240
RATE_LIMIT_API=120

# ---------------------------------------------------------------- live prices
# Best Buy Products API (live new prices, US). Get a key at https://developer.bestbuy.com
BESTBUY_API_KEY=

# eBay Browse API (live used prices, US). Create a keyset at https://developer.ebay.com/my/keys
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# production or sandbox
EBAY_ENV=production
EBAY_MARKETPLACE=EBAY_US

# How often to refresh live prices, in hours (eBay data must be under 6 h old)
PRICE_TTL_HOURS=6

# Lets you trigger POST /api/prices/refresh with "Authorization: Bearer <token>"
ADMIN_TOKEN=
